{
  "uid": "adapt-config-drift",
  "title": "ADAPT \u00b7 Config Drift",
  "description": "Resource pool saturation following a configuration change",
  "tags": [
    "adapt-data",
    "incident",
    "config_drift"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "adapt-prometheus"
        },
        "query": {
          "query": "label_values(service)",
          "refId": "adapt-services"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Incident window",
        "datasource": {
          "type": "prometheus",
          "uid": "adapt-prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\"}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Transaction Pool Utilization",
      "description": "Saturation after an undersized pool is applied",
      "datasource": {
        "type": "prometheus",
        "uid": "adapt-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "adapt-prometheus"
          },
          "expr": "transaction_pool_utilization{service=~\"$service\"}",
          "legendFormat": "{{service}} \u00b7 {{host}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "adapt-prometheus"
          },
          "expr": "transaction_pool_size{service=~\"$service\"}",
          "legendFormat": "{{service}} \u00b7 {{host}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue Depth",
      "description": "Work backing up behind the saturated pool",
      "datasource": {
        "type": "prometheus",
        "uid": "adapt-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "adapt-prometheus"
          },
          "expr": "transaction_queue_depth{service=~\"$service\"}",
          "legendFormat": "{{service}} \u00b7 {{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request Duration (p95)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "adapt-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "adapt-prometheus"
          },
          "expr": "http_request_duration_p95{service=~\"$service\"}",
          "legendFormat": "{{service}} \u00b7 {{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error Rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "adapt-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "adapt-prometheus"
          },
          "expr": "http_error_rate{service=~\"$service\"}",
          "legendFormat": "{{service}} \u00b7 {{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
