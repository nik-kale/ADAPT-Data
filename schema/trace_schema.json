{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADAPT Trace Schema",
  "description": "Schema for synthetic distributed traces in ADAPT-Data",
  "type": "object",
  "required": ["trace_id", "spans"],
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "Unique trace identifier"
    },
    "spans": {
      "type": "array",
      "description": "List of spans in this trace",
      "items": {
        "type": "object",
        "required": ["span_id", "parent_span_id", "service", "operation", "start_time", "duration_ms"],
        "properties": {
          "span_id": {
            "type": "string",
            "description": "Unique span identifier"
          },
          "parent_span_id": {
            "type": ["string", "null"],
            "description": "Parent span ID (null for root span)"
          },
          "service": {
            "type": "string",
            "description": "Service executing this span"
          },
          "operation": {
            "type": "string",
            "description": "Operation name (e.g., HTTP GET /api/users)"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "description": "Span start timestamp"
          },
          "duration_ms": {
            "type": "number",
            "description": "Duration in milliseconds"
          },
          "status": {
            "type": "string",
            "enum": ["OK", "ERROR", "TIMEOUT"],
            "description": "Span status"
          },
          "tags": {
            "type": "object",
            "description": "Span tags/metadata",
            "additionalProperties": true
          },
          "logs": {
            "type": "array",
            "description": "Span-scoped log events",
            "items": {
              "type": "object",
              "properties": {
                "timestamp": {"type": "string", "format": "date-time"},
                "message": {"type": "string"},
                "fields": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
