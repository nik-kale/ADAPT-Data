{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADAPT Log Entry Schema",
  "description": "Schema for synthetic log entries in ADAPT-Data",
  "type": "object",
  "required": ["timestamp", "level", "service", "message"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "level": {
      "type": "string",
      "enum": ["DEBUG", "INFO", "WARN", "ERROR", "FATAL"],
      "description": "Log level"
    },
    "service": {
      "type": "string",
      "description": "Service or component name"
    },
    "message": {
      "type": "string",
      "description": "Log message content"
    },
    "trace_id": {
      "type": "string",
      "description": "Optional distributed trace ID"
    },
    "span_id": {
      "type": "string",
      "description": "Optional span ID within a trace"
    },
    "host": {
      "type": "string",
      "description": "Host or pod identifier"
    },
    "region": {
      "type": "string",
      "description": "Cloud region or datacenter"
    },
    "metadata": {
      "type": "object",
      "description": "Additional structured metadata",
      "properties": {
        "user_id": {"type": "string"},
        "request_id": {"type": "string"},
        "endpoint": {"type": "string"},
        "method": {"type": "string"},
        "status_code": {"type": "integer"},
        "duration_ms": {"type": "number"},
        "error_code": {"type": "string"},
        "stack_trace": {"type": "string"}
      }
    },
    "labels": {
      "type": "object",
      "description": "Key-value labels for categorization",
      "additionalProperties": {"type": "string"}
    }
  }
}
