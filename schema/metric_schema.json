{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADAPT Metric Schema",
  "description": "Schema for synthetic metrics in ADAPT-Data",
  "type": "object",
  "required": ["timestamp", "metric_name", "value", "service"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "metric_name": {
      "type": "string",
      "description": "Name of the metric (e.g., http_requests_total, latency_p95)"
    },
    "value": {
      "type": "number",
      "description": "Metric value"
    },
    "service": {
      "type": "string",
      "description": "Service or component name"
    },
    "metric_type": {
      "type": "string",
      "enum": ["counter", "gauge", "histogram", "summary"],
      "description": "Type of metric"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement (ms, bytes, requests, etc.)"
    },
    "host": {
      "type": "string",
      "description": "Host or pod identifier"
    },
    "region": {
      "type": "string",
      "description": "Cloud region or datacenter"
    },
    "tags": {
      "type": "object",
      "description": "Metric tags/dimensions",
      "additionalProperties": {"type": "string"}
    },
    "anomaly_injected": {
      "type": "boolean",
      "description": "Flag indicating if this is an anomalous value",
      "default": false
    }
  }
}
